# ============================================================================
# Slotted — Environment Configuration (.env.local)
# ============================================================================
#
# Dual-Mode Persistence:
# - Out of the box (without DATABASE_URL), Slotted automatically persists all
#   polls, votes, passwords, and locks to `.data/slotted-db.json` via its Next.js
#   API Route Handlers (`/api/polls/*`).
# - The moment you drop in `DATABASE_URL` below, Slotted automatically switches
#   to Neon Serverless Postgres via Drizzle ORM with zero code changes.
#
# 1. Neon Serverless Postgres (Pooled Connection String)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Clerk Progressive Authentication (Optional — enables cross-device poll sync)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# 3. Public App URL (Used for canonical share links & OpenGraph cards)
NEXT_PUBLIC_APP_URL="http://localhost:43123"
