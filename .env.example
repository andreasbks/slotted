# Copy to .env.local. Never commit real values.
#
# Local development without DATABASE_URL uses .data/slotted-db.json.
# When DATABASE_URL is present, every store operation uses Neon through Drizzle.
# Deployed environments require DATABASE_URL and SLOTTED_TOKEN_PEPPER.

# Pooled Neon URL for application requests (Vercel injects this name).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct Neon URL for migrations only. Do not point the app runtime at this.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Required in deployed environments. Use a distinct value per Development, Preview, and Production.
# At least 32 characters. Never prefix with NEXT_PUBLIC_.
SLOTTED_TOKEN_PEPPER="replace-with-a-long-random-string"

# Optional. Enables Google/Apple sign-in. Guest access works without these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Optional and currently unused. Share links use the browser origin.
NEXT_PUBLIC_APP_URL="http://localhost:43123"
